# Copy to .env in the project root and edit.

# 0 = USB webcam (only when running directly on that PC),
# "rtsp://user:pass@192.168.1.64:554/stream" = IP camera,
# "data/video.mp4" = test file.
CAMERA_SOURCE=rtsp://user:pass@192.168.1.64:554/stream

MODEL_WEIGHTS=yolo11n.pt
MODEL_DEVICE=auto
SIMULATE=false
TABLES_MODE=roi
SERVE_MODE=both

# Basic auth for dashboard/APIs (recommended if not using Cloudflare Access)
AUTH_USERNAME=admin
AUTH_PASSWORD=change-this-strong-password

# Only needed with docker-compose.cloudflare.yml
CLOUDFLARE_TUNNEL_TOKEN=
